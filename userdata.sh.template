#!/bin/bash
# Artifactory 7.x single-node bootstrap for Amazon Linux 2023.
# Fail the boot visibly (ASG health check replaces the instance) rather than
# carrying on with a half-installed Artifactory.
set -euo pipefail

JFROG_HOME=/opt/jfrog
ART_VAR=$JFROG_HOME/artifactory/var

dnf -y upgrade

## Install Artifactory (pinned version, signed repo metadata)
# gpgcheck=0 because the RPM signing key is not confirmed; the repo metadata
# (which carries the package checksums) is GPG-verified by repo_gpgcheck=1.
cat <<'EOF' >/etc/yum.repos.d/jfrog-artifactory-pro.repo
[Artifactory]
name=Artifactory
baseurl=https://releases.jfrog.io/artifactory/artifactory-pro-rpms
enabled=1
gpgcheck=0
gpgkey=https://releases.jfrog.io/artifactory/artifactory-pro-rpms/repodata/repomd.xml.key
repo_gpgcheck=1
EOF
dnf install -y jfrog-artifactory-pro-${artifactory_version} >> /tmp/dnf-artifactory.log 2>&1

## MySQL JDBC driver (checksum verified)
DRIVER_DIR=$ART_VAR/bootstrap/artifactory/tomcat/lib
DRIVER_JAR=mysql-connector-j-8.4.0.jar
mkdir -p $DRIVER_DIR
curl -fsSL -o /tmp/$DRIVER_JAR https://repo1.maven.org/maven2/com/mysql/mysql-connector-j/8.4.0/$DRIVER_JAR
echo "d77962877d010777cff997015da90ee689f0f4bb76848340e1488f2b83332af5  /tmp/$DRIVER_JAR" | sha256sum -c -
install -m 644 /tmp/$DRIVER_JAR $DRIVER_DIR/$DRIVER_JAR

## Secrets come from SSM Parameter Store (not user_data); files are root-only
## until the chown below hands them to the artifactory user.
umask 077
DB_PASSWORD=$(aws ssm get-parameter --region ${s3_bucket_region} --name ${db_password_param} --with-decryption --query Parameter.Value --output text)
MASTER_KEY=$(aws ssm get-parameter --region ${s3_bucket_region} --name ${master_key_param} --with-decryption --query Parameter.Value --output text)
# single-quote the password for YAML (double any embedded single quote)
DB_PASSWORD_YAML=$(printf '%s' "$DB_PASSWORD" | sed "s/'/''/g")

mkdir -p $ART_VAR/etc/security $ART_VAR/etc/artifactory

printf '%s\n' "$MASTER_KEY" > $ART_VAR/etc/security/master.key

# S3 filestore using the instance role (no static credentials)
cat <<EOF > $ART_VAR/etc/artifactory/binarystore.xml
<config version="2">
    <chain template="s3-storage-v3-direct"/>
    <provider id="s3-storage-v3" type="s3-storage-v3">
        <region>${s3_bucket_region}</region>
        <bucketName>${s3_bucket_name}</bucketName>
        <path>filestore</path>
        <useInstanceCredentials>true</useInstanceCredentials>
    </provider>
</config>
EOF

# Database and JVM settings. MySQL is a non-PostgreSQL database, so the explicit
# opt-in is required. useSSL=false follows JFrog's MySQL example (traffic stays
# inside the VPC); enabling TLS needs the RDS CA in the Java truststore.
cat <<EOF > $ART_VAR/etc/system.yaml
shared:
  extraJavaOpts: '${EXTRA_JAVA_OPTS}'
  database:
    allowNonPostgresql: true
    type: mysql
    driver: com.mysql.cj.jdbc.Driver
    url: 'jdbc:mysql://${db_url}/${db_name}?characterEncoding=UTF-8&elideSetAutoCommits=true&useSSL=false'
    username: '${db_user}'
    password: '$DB_PASSWORD_YAML'
EOF
umask 022

chown -R artifactory:artifactory $ART_VAR/etc $DRIVER_DIR

systemctl enable --now artifactory.service
